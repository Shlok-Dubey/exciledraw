// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  firstname String
  password  String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

   rooms     Room[] 
}

model Room {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}